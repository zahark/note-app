# Copy to .env and fill in. The server refuses to boot if the secrets are missing or short,
# and `docker compose` refuses to start without SESSION_SECRET, SHARE_HMAC_KEY and PUBLIC_ORIGIN.

# Random secret for session signing (at least 32 chars). e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Random key for HMAC-signed share links (at least 32 chars). e.g. `openssl rand -hex 32`
SHARE_HMAC_KEY=

# Exact public origin the app is served from (scheme + host [+ port], no path).
# Cookies get the Secure flag when this is https. Dev (Vite): http://localhost:5173;
# Docker direct: http://<host>:3000; behind nginx / a tunnel / Fly.io: https://notes.example.com
PUBLIC_ORIGIN=http://localhost:5173

# Trusted reverse proxy: a hop count (e.g. 1) or a comma-separated list of proxy IPs/CIDRs.
# Leave unset when there is no proxy. A bare `true` is rejected.
# RULE: whenever TRUST_PROXY is set, the app port must be reachable ONLY through that proxy,
# otherwise a direct request can forge X-Forwarded-For and dodge the per-IP rate limits.
# With Docker Compose the deployment override sets it (a value here is ignored there):
#   docker compose -f docker-compose.yml -f compose.direct.yml up -d   # unset - LAN / testing only
#   docker compose -f docker-compose.yml -f compose.nginx.yml up -d    # 1 (port on 127.0.0.1 only)
#   docker compose -f docker-compose.yml -f compose.tunnel.yml up -d   # 172.30.0.10 (cloudflared)
# Fly.io: leave TRUST_PROXY unset and use CLIENT_IP_HEADER below instead.
# TRUST_PROXY=

# Header the platform's proxy sets to the client address on every request, e.g. Fly-Client-IP on
# Fly.io (fly.toml sets it). The per-IP rate limits then use its value (an IPv4/IPv6 address; a missing
# or invalid value falls back to the socket address). Same rule as TRUST_PROXY: set it only when the
# app is reachable solely through that proxy. Cannot be combined with TRUST_PROXY. Docker Compose pins
# it empty (a value here is ignored there).
# CLIENT_IP_HEADER=

# Who can sign up. Unset (default): only while no account exists, so the owner can create theirs on
# first run; signup is closed after that. true: anyone, any time (only for trusted users - every account
# can grow the data volume). false: nobody, not even on an empty database (the owner must already exist,
# e.g. restored from a backup).
# ALLOW_SIGNUP=

# Directory holding the SQLite database and uploads (Docker always uses the /data volume).
DATA_DIR=./data

HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace. `debug` logs every request's client address and the
# IP key the rate limits use, to check TRUST_PROXY against the deployment.
LOG_LEVEL=info

# Most attachment storage (images, PDF and GPX files together) one account may use, in MB
# (0 = no limit). Removed attachments count until the sweep deletes them, 7 days after removal.
# UPLOAD_QUOTA_MB=1024

# Daily off-site backups to an S3-compatible bucket (Cloudflare R2). Off unless the first four are
# all set; setting only some of them refuses to boot. Backups are NOT encrypted by the app: keep the
# R2 API token (Object Read & Write on this bucket only) private. Do not add a bucket lifecycle rule;
# the app prunes old backups itself, only after a newer one uploaded successfully.
# Endpoint: the https origin only, no path. Bucket: 3-63 lowercase letters, digits, - and .
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Optional: signing region (R2 expects auto); key prefix (a trailing / is added; no leading / or ..);
# back up when the last successful upload is older than this many hours (1-168); prune backups older
# than this many days, always keeping the newest 7 (1-3650).
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=notes-backups/
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=30

# 1 or true: discard a restore staged by `npm run restore:offsite` at the next start instead of applying
# it (a swap already in progress is rolled back first). Unset it again afterwards.
# RESTORE_ABORT=

# compose.tunnel.yml only: the Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels).
# CLOUDFLARE_TUNNEL_TOKEN=
