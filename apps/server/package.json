{
  "name": "@notes-app/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "start": "node dist/index.js",
    "reset-password": "node dist/cli/reset-password.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.1.1",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  }
}
